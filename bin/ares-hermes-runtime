    if "--archive-session" in sys.argv:
        sid = sys.argv[sys.argv.index("--archive-session") + 1]
        profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else "default"
        result = mutate_session(sid, profile=profile, archived=True)
