        scope = sys.argv[sys.argv.index("--draft") + 1]
        conversation_id = sys.argv[sys.argv.index("--draft") + 2]
        print(json.dumps({"ok": True, "draft": get_draft(scope, conversation_id)}))
        return
    if "--save-draft" in sys.argv:
        scope = sys.argv[sys.argv.index("--save-draft") + 1]
        conversation_id = sys.argv[sys.argv.index("--save-draft") + 2]
        text = sys.argv[sys.argv.index("--text") + 1] if "--text" in sys.argv else ""
        image = sys.argv[sys.argv.index("--image") + 1] if "--image" in sys.argv else ""
        print(json.dumps({"ok": True, "draft": save_draft(scope, conversation_id, text, image)}))
        return
    if "--delete-draft" in sys.argv:
        scope = sys.argv[sys.argv.index("--delete-draft") + 1]
        conversation_id = sys.argv[sys.argv.index("--delete-draft") + 2]
        delete_draft(scope, conversation_id)
        print(json.dumps({"ok": True}))
        return
    if "--chats" in sys.argv:
        print(json.dumps(list_chats(), default=str))
        return
    if "--prefs" in sys.argv:
        print(json.dumps(load_preferences()))
        return
    elif "--set-pref" in sys.argv:
        key = sys.argv[sys.argv.index("--set-pref") + 1]
        value = sys.argv[sys.argv.index("--set-pref") + 2]
        print(json.dumps(set_preference(key, value)))
        return
    elif "--rename-peer-agent" in sys.argv:
        name = sys.argv[sys.argv.index("--rename-peer-agent") + 1]
        profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else "default"
        title = sys.argv[sys.argv.index("--title") + 1] if "--title" in sys.argv else ""
        print(json.dumps(set_peer_agent_title(name, profile, title), ensure_ascii=False))
        return
    elif "--rename-peer" in sys.argv:
        name = sys.argv[sys.argv.index("--rename-peer") + 1]
        title = sys.argv[sys.argv.index("--title") + 1] if "--title" in sys.argv else ""
        print(json.dumps(set_peer_title(name, title), ensure_ascii=False))
        return
    if "--peers" in sys.argv:
        print(json.dumps(list_peers()))
        return
    if "--sync-omarchy-docs" in sys.argv:
        print(json.dumps(sync_omarchy_docs_skills()))
        return
    if "--sync-peers" in sys.argv:
        print(json.dumps(sync_peers()))
        return
    if "--set-lan-access" in sys.argv:
        value = sys.argv[sys.argv.index("--set-lan-access") + 1].strip().lower()
        print(json.dumps(set_lan_access(value in ("1", "true", "on", "yes"))))
        return
    if "--discover" in sys.argv:
        print(json.dumps(discover_peers()))
        return
    if "--session" in sys.argv:
        sid = sys.argv[sys.argv.index("--session") + 1]
        profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else ""
        try:
            lim = int(sys.argv[sys.argv.index("--limit") + 1]) if "--limit" in sys.argv else 30
            off = int(sys.argv[sys.argv.index("--offset") + 1]) if "--offset" in sys.argv else 0
        except Exception:
            lim, off = 30, 0
        detail = (remote_session_chat(sid, limit=lim, offset=off)
                  if _parse_remote_ref(sid)
                  else list_chats(session_id=sid, limit=lim, offset=off, profile=profile))
        print(json.dumps(detail, default=str))
        return
    if "--ensure-bot-chat" in sys.argv:
        profile = sys.argv[sys.argv.index("--ensure-bot-chat") + 1]
        print(json.dumps(ensure_local_bot_chat(profile)))
        return
    if "--create-chat" in sys.argv:
        profile = sys.argv[sys.argv.index("--create-chat") + 1]
        print(json.dumps(create_local_chat(profile)))
        return
    if "--mark-read" in sys.argv:
        sid = sys.argv[sys.argv.index("--mark-read") + 1]
        if _parse_remote_ref(sid):
            print(json.dumps({"ok": True, "remote": True}))
            return
        profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else ""
        ok = False
        try:
            conn = sqlite3.connect(_profile_state_db(profile), timeout=2)
            conn.execute("UPDATE sessions SET last_read_at=? WHERE id=?",
                         (time.time(), sid))
            conn.commit()
            conn.close()
            ok = True
        except Exception:
            pass
        print(json.dumps({"ok": ok}))
        return
    if "--create-bot" in sys.argv:
        name = sys.argv[sys.argv.index("--create-bot") + 1]
        desc = ""
        if "--description" in sys.argv:
