    if "--rename-session" in sys.argv:
        sid = sys.argv[sys.argv.index("--rename-session") + 1]
        profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else "default"
        title = sys.argv[sys.argv.index("--title") + 1] if "--title" in sys.argv else ""
        print(json.dumps(mutate_session(sid, profile=profile, title=title), ensure_ascii=False))
