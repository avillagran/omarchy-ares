            return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv else None
        hidden = None
        if "--hidden" in sys.argv:
            hidden = sys.argv[sys.argv.index("--hidden") + 1].lower() in ("1", "true", "yes")
        print(json.dumps(update_bot(
            name,
            title=_arg("--title"),
            description=_arg("--description"),
            model=_arg("--model"),
            provider=_arg("--provider"),
            hidden=hidden,
            avatar_shape=_arg("--avatar-shape"),
            avatar_color=_arg("--avatar-color"),
        )))
