        text = sys.argv[sys.argv.index("--text") + 1] if "--text" in sys.argv else ""
        image = sys.argv[sys.argv.index("--image") + 1] if "--image" in sys.argv else None
        try:
            print(json.dumps({"ok": True, "result": send_room_message(room_id, text, image)}))
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)[:240]}))
        return
    if "--rename-room" in sys.argv:
        room_id = sys.argv[sys.argv.index("--rename-room") + 1]
        name = sys.argv[sys.argv.index("--name") + 1] if "--name" in sys.argv else ""
        try:
            print(json.dumps({"ok": True, "result": rename_room(room_id, name)}))
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)[:240]}))
        return
    if "--create-group" in sys.argv:
        name = sys.argv[sys.argv.index("--create-group") + 1]
        members = []
        if "--members" in sys.argv:
            members = [m.strip() for m in sys.argv[sys.argv.index("--members") + 1].split(",") if m.strip()]
        print(json.dumps(create_group(name, members)))
        return
    if "--disband-group" in sys.argv:
        gid = sys.argv[sys.argv.index("--disband-group") + 1]
        print(json.dumps(disband_group(gid)))
        return
    if "--enable-botmode" in sys.argv:
        print(json.dumps(enable_bot_mode()))
        return
    if "--bots" in sys.argv:
        print(json.dumps(list_bots(quick="--quick" in sys.argv), default=str))
        return
    if "--botstatus" in sys.argv:
        gw = False
        try:
            r = subprocess.run(["pgrep", "-f", "hermes.*gateway"], capture_output=True, timeout=5)
            gw = r.returncode == 0
        except Exception:
            pass
        print(json.dumps({
            "gatewayRunning": gw,
            "botModeProtocol": _bot_mode_protocol_enabled(),
        }))
        return
    if "--models" in sys.argv:
        filt = sys.argv[sys.argv.index("--models") + 1] if len(sys.argv) > sys.argv.index("--models") + 1 else ""
        print(json.dumps(list_models(filt)))
        return
    if "--status" in sys.argv:
        print(json.dumps(dashboard_status()))
        return
    if "--send" in sys.argv:
        sid = sys.argv[sys.argv.index("--send") + 1]
        profile = sys.argv[sys.argv.index("--profile") + 1] if "--profile" in sys.argv else ""
        text = sys.argv[sys.argv.index("--text") + 1] if "--text" in sys.argv else ""
        image = sys.argv[sys.argv.index("--image") + 1] if "--image" in sys.argv else None
        if _parse_remote_ref(sid):
            print(json.dumps(send_remote_session(sid, text, image)))
            return
        cmd = [HERMES_BIN, HERMES_MAIN]
        if profile and profile != "default":
            cmd += ["-p", profile]
        cmd += ["chat", "-q", text, "--resume", sid, "--oneshot", "--quiet"]
        if image:
            cmd += ["--image", image]
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
            print(json.dumps({"ok": r.returncode == 0,
                              "stderr": (r.stderr or "")[-300:],
                              "image": bool(image)}))
        except Exception as e:
            print(json.dumps({"ok": False, "error": str(e)[:200]}))
        return
    if "--focus" in sys.argv:
        pid = sys.argv[sys.argv.index("--focus") + 1]
        out = {"ok": False}
        try:
            r = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=8)
            for c in json.loads(r.stdout or "[]"):
                if str(c.get("pid")) == str(pid):
                    addr = c.get("address", "")
                    subprocess.run(["hyprctl", "dispatch", "focuswindow",
                                    "address:%s" % addr], capture_output=True, timeout=8)
                    out = {"ok": True, "address": addr, "title": c.get("title", "")[:60]}
                    break
        except Exception as e:
            out["error"] = str(e)[:200]
        print(json.dumps(out))
        return

    sessions = list_sessions()
    running = running_hermes_procs()

    active = []
    for s in sessions:
        pid = running.get(s["id"])
        if pid is not None:
            s["pid"] = pid
            active.append(s)

    # Remote conversations are first-class Agents entries. Their composite ID
    # preserves host/profile/session identity, so equal profile or session names
    # on different gateways can never collapse into one row.
    remote = list_remote_sessions()
    combined = active + remote
    combined.sort(key=lambda row: row.get("lastActivityTs", 0), reverse=True)

    output = {
        "active": len(active) + sum(1 for row in remote if row.get("working")),
        "sessions": combined,
    }
    print(json.dumps(output))


if __name__ == "__main__":
    main()
