            print(json.dumps({"ok": True, "path": save_clipboard_image()}))
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)[:240]}))
        return
    if "--remove-room-member" in sys.argv:
        try:
            room_id = sys.argv[sys.argv.index("--remove-room-member") + 1]
            member = sys.argv[sys.argv.index("--member") + 1]
            expected_revision = int(sys.argv[sys.argv.index("--expected-revision") + 1])
            idempotency_key = sys.argv[sys.argv.index("--idempotency-key") + 1]
            result = remove_room_member(room_id, member, expected_revision=expected_revision,
                                        idempotency_key=idempotency_key)
            print(json.dumps(result, ensure_ascii=False))
            if result.get("ok") is not True:
                raise SystemExit(1)
        except SystemExit:
            raise
        except Exception as exc:
            print(json.dumps({"ok": False, "status": "error", "error": str(exc)[:240]}, ensure_ascii=False))
            raise SystemExit(1)
        return
    if "--add-room-member" in sys.argv:
        try:
            room_id = sys.argv[sys.argv.index("--add-room-member") + 1]
            profile = sys.argv[sys.argv.index("--profile") + 1]
            bots = {bot["name"]: bot for bot in list_bots(quick=True).get("bots", [])}
            descriptors = member_descriptors([profile], bots)
            if not descriptors:
                raise ValueError("invalid member profile")
            result = add_room_member(room_id, descriptors[0])
            print(json.dumps({"ok": True, **result}, ensure_ascii=False))
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)[:240]}, ensure_ascii=False))
            raise SystemExit(1)
        return
    if "--groups" in sys.argv:
        print(json.dumps(list_room_chats()))
        return
    if "--room-capabilities" in sys.argv:
        try:
            print(json.dumps({"ok": True, "capabilities": room_request("capabilities")}, ensure_ascii=False))
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)[:240]}, ensure_ascii=False))
        return
    if "--room" in sys.argv:
        room_id = sys.argv[sys.argv.index("--room") + 1]
        try:
            limit = int(sys.argv[sys.argv.index("--limit") + 1]) if "--limit" in sys.argv else 200
            state = room_request("state", room_id=room_id, **({"limit": limit} if room_id.startswith("desktop::") else {}))
            replay = state if state.get("source") == "desktop" else room_log(room_id, limit=limit)
            print(json.dumps({"ok": True, "room": state.get("room") or {},
                              "source": state.get("source") or "legacy",
                              "readOnly": state.get("readOnly", False),
                              "historyPartial": state.get("historyPartial", False),
                              "driverStatus": state.get("driver_status") or {},
                              "events": replay.get("events") or [],
