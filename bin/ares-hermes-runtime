    if "--native-room-status" in sys.argv:
        room_id = sys.argv[sys.argv.index("--native-room-status") + 1]
        try:
            print(json.dumps({"ok": True, "result": native_status(room_id)}))
        except Exception as exc:
            print(json.dumps({"ok": False, "error": str(exc)[:240]}))
        return
